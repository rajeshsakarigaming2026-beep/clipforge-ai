# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the full cloud app, used by the Vercel marketing site
NEXT_PUBLIC_CLOUD_APP_URL=https://clipforge-ai-3wsy.onrender.com
# Public URL of the free worker web service, used to wake it before queueing jobs
WORKER_URL=https://clipforge-ai-worker-b28h.onrender.com
# Set to true on a cloud deployment: jobs are queued in the database and run by the worker service.
CLOUD_WORKER=false
# web or worker (used by the Docker image)
CLIPFORGE_ROLE=web

# Database. SQLite is used for local development.
# For PostgreSQL, see README.md ("Switching to PostgreSQL").
DATABASE_URL="file:./dev.db"

# Auth: generate with `openssl rand -base64 32` (or any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Local storage root for uploaded sources and rendered clips
STORAGE_ROOT="./storage"

# S3-compatible storage is required on Render (Cloudflare R2, AWS S3, etc.)
# because web and worker do not share a local disk.
# Storage driver: local | database (free, stores files in Postgres) | s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Video processing
# Path to the Python interpreter that has whisper, opencv-python, numpy and Pillow installed.
# The stream-clips skill environment is detected automatically when this is empty.
VIDEO_PYTHON=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_MB=2048
MAX_SOURCE_SECONDS=1800
YT_COOKIES_FROM_BROWSER=
YT_COOKIES_FILE=

# Optional AI highlight provider. Leave empty to use the built-in local heuristic.
# Supported values: local, openai
HIGHLIGHT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=admin@clipforge.ai,demo@clipforge.ai,your@email.com
# Local demo only: allow any signed-in user into /admin
ADMIN_ALL_USERS=false

# Google sign-in. Create OAuth client credentials in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# On Vercel use: https://your-project.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
